# =============================================================
# VARIÁVEIS DE AMBIENTE — copie este arquivo para .env e
# preencha com suas credenciais. NUNCA comite o .env.
# =============================================================

# -------------------------------------------------------
# Provedor de LLM: "mock" (padrão, sem credenciais) | "watsonx" | "openai"
# Mantenha "mock" para desenvolvimento local sem credenciais.
# Troque para "watsonx" quando tiver as chaves configuradas abaixo.
# -------------------------------------------------------
LLM_PROVIDER=mock

# -------------------------------------------------------
# IBM watsonx.ai — análise de texto (LLM pipeline) e imagens (multimodal)
# Documentação: https://cloud.ibm.com/apidocs/watsonx-ai
#
# WATSONX_API_KEY  : chave IAM do IBM Cloud
#   Obter em: https://cloud.ibm.com/iam/apikeys
# WATSONX_PROJECT_ID : ID do projeto watsonx.ai
#   Obter em: https://dataplatform.cloud.ibm.com → Manage → Details
# WATSONX_URL      : endpoint regional (us-south, eu-de, etc.)
# WATSONX_MODEL_ID : modelo de linguagem para análise de texto
# WATSONX_VISION_MODEL_ID : modelo multimodal para análise de imagens
#   Recomendado: meta-llama/llama-3-2-90b-vision-instruct (multitenant)
#   Suporta: imagens JPG, PNG, WEBP | Língua: português
# -------------------------------------------------------
WATSONX_API_KEY=seu_api_key_aqui
WATSONX_PROJECT_ID=seu_project_id_aqui
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_VISION_MODEL_ID=meta-llama/llama-3-2-90b-vision-instruct

# -------------------------------------------------------
# IBM Watson Speech to Text — transcrição de áudios
# ATENÇÃO: serviço SEPARADO do watsonx.ai — requer instância própria no IBM Cloud.
# A chave WATSONX_API_KEY NÃO dá acesso ao Watson STT.
#
# WATSON_STT_API_KEY : chave de API da instância Watson Speech to Text
# WATSON_STT_URL     : URL da instância (formato: api.<região>.speech-to-text.watson.cloud.ibm.com)
#
# Como obter:
#   1. Acesse https://cloud.ibm.com/catalog/services/speech-to-text
#   2. Crie uma instância (plano Lite gratuito disponível)
#   3. Abra a instância → "Manage" → copie API key e URL
#
# Modelo usado: pt-BR_BroadbandModel (português brasileiro de banda larga)
# -------------------------------------------------------
WATSON_STT_API_KEY=seu_watson_stt_key_aqui
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# -------------------------------------------------------
# OpenAI (mantido para compatibilidade — não utilizado pelo multimodal IBM)
# -------------------------------------------------------
OPENAI_API_KEY=seu_openai_key_aqui
OPENAI_MODEL_ID=gpt-4o

# -------------------------------------------------------
# Aplicação
# -------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./bb_ia_mvp.db

# -------------------------------------------------------
# Segurança
# -------------------------------------------------------
# Tamanho máximo do input do usuário (caracteres)
MAX_INPUT_LENGTH=2000
# Habilitar proteção anti-prompt-injection
PROMPT_INJECTION_GUARD=true
